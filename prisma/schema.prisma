generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  DOSEN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(DOSEN)
  isLecturer    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mahasiswaList Mahasiswa[]
  buktiList     Bukti[]
}

model Mahasiswa {
  id        String   @id @default(cuid())
  nim       String   @unique
  nama      String
  prodi     String
  kelas     String
  mitra     String
  kota      String
  zona      String
  dosenNama String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dosen     User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([userId])
}

// Bukti dokumentasi per PERUSAHAAN (mitra), bukan per mahasiswa.
// Tipe: PENYERAHAN | SUPERVISI | PENARIKAN
model Bukti {
  id        String   @id @default(cuid())
  tipe      String
  judul     String
  url       String
  catatan   String?
  mitra     String
  tanggal   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([mitra])
  @@index([userId])
}
